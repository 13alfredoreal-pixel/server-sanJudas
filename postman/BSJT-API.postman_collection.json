{
  "info": {
    "_postman_id": "bsjt-server-api-collection",
    "name": "Biblioteca Virtual SJT — API",
    "description": "Colección completa del API server-sanJudas (auth JWT + refresh cookie, libros Supabase/Cloudinary, usuarios, categorías, reseñas, analytics).\n\n## Uso rápido\n1. Importa esta colección y el environment `BSJT-Local.postman_environment.json`.\n2. Selecciona environment **BSJT Local**.\n3. Ejecuta **Auth → Login (admin)** — guarda `accessToken` automáticamente.\n4. Corre el resto de requests (usa variables `bookId`, `categoryId`, etc. tras crear recursos).\n\n## Auth\n- Access: header `Authorization: Bearer {{accessToken}}`\n- Refresh: cookie HttpOnly `refreshToken` (Postman debe enviar cookies; activar cookies del dominio localhost).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.uid) pm.collectionVariables.set('userId', j.uid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Usuario",
                  "type": "text"
                },
                {
                  "key": "surname",
                  "value": "Prueba",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "user_test_{{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "user_test_{{$timestamp}}@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Test1234!",
                  "type": "text"
                },
                {
                  "key": "confirmPassword",
                  "value": "Test1234!",
                  "type": "text"
                },
                {
                  "key": "profilePicture",
                  "type": "file",
                  "src": [],
                  "description": "Opcional — imagen jpeg/png/webp"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registro multipart. Cookie refresh se setea; no siempre devuelve access token (revisar body)."
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.token) {",
                  "  pm.collectionVariables.set('accessToken', j.token);",
                  "  pm.environment.set('accessToken', j.token);",
                  "}",
                  "if (j.uid) pm.collectionVariables.set('userId', j.uid);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login admin seed. Guarda Bearer en `accessToken`. Setea cookie `refreshToken`."
          }
        },
        {
          "name": "Login (email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) {",
                  "  pm.collectionVariables.set('accessToken', j.token);",
                  "  pm.environment.set('accessToken', j.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sanjudas.edu.gt\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.token) {",
                  "  pm.collectionVariables.set('accessToken', j.token);",
                  "  pm.environment.set('accessToken', j.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/refresh-token",
            "description": "Usa cookie `refreshToken` del login previo. Actualiza `accessToken`."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Limpia cookie refresh."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const list = j.users || j || [];",
                  "if (Array.isArray(list) && list[0]?._id) {",
                  "  pm.collectionVariables.set('userId', list[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Administrador",
                  "type": "text"
                },
                {
                  "key": "surname",
                  "value": "Principal",
                  "type": "text"
                },
                {
                  "key": "bio",
                  "value": "Prueba Postman",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "5495-7813",
                  "type": "text"
                },
                {
                  "key": "profilePicture",
                  "type": "file",
                  "src": [],
                  "description": "Opcional"
                }
              ]
            },
            "url": "{{baseUrl}}/users/update"
          }
        },
        {
          "name": "Update password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/users/update-password",
            "description": "Ajusta body según nombres exactos que espere el controller."
          }
        },
        {
          "name": "Promote user (admin)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/users/promote/{{userId}}"
          }
        },
        {
          "name": "Toggle favorite",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/toggle-favorite/{{bookId}}"
          }
        },
        {
          "name": "Get favorites",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/favorites"
          }
        },
        {
          "name": "Update reading progress",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"page\": 3\n}"
            },
            "url": "{{baseUrl}}/users/reading-progress"
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/delete/{{userId}}",
            "description": "Cuidado: irreversible. No uses el admin principal en pruebas."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.books?.[0]?._id) pm.collectionVariables.set('bookId', j.books[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books?page=1&limit=10&search=&category=",
            "description": "Query: page, limit, search, category"
          }
        },
        {
          "name": "Get book by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Upload book (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.book?._id) pm.collectionVariables.set('bookId', j.book._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Libro Postman {{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "author",
                  "value": "Autor Prueba",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "arte",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Subida de prueba BSJT",
                  "type": "text"
                },
                {
                  "key": "pdf",
                  "type": "file",
                  "src": [],
                  "description": "Obligatorio — PDF (va a Supabase)"
                },
                {
                  "key": "cover",
                  "type": "file",
                  "src": [],
                  "description": "Opcional — imagen (Cloudinary)"
                }
              ]
            },
            "url": "{{baseUrl}}/books",
            "description": "Requiere ADMIN_ROLE. PDF → Supabase; cover → Cloudinary."
          }
        },
        {
          "name": "Get PDF signed URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/signed-url",
            "description": "Devuelve signedUrl (Supabase 1h o legacy Cloudinary)."
          }
        },
        {
          "name": "Proxy PDF stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}/pdf",
            "description": "Stream application/pdf. En Postman: Send and Download."
          }
        },
        {
          "name": "Delete book (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.categories?.[0]?._id) pm.collectionVariables.set('categoryId', j.categories[0]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Create category (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const id = j.category?._id || j._id;",
                  "if (id) pm.collectionVariables.set('categoryId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"categoria-postman-{{$timestamp}}\",\n  \"icon\": \"📚\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Delete category (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Add review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.review?._id) pm.collectionVariables.set('reviewId', j.review._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excelente recurso (Postman)\"\n}"
            },
            "url": "{{baseUrl}}/reviews"
          }
        },
        {
          "name": "Get reviews by book",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews/book/{{bookId}}"
          }
        },
        {
          "name": "Delete review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/reviews/{{reviewId}}"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "General stats (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics",
            "description": "Solo ADMIN_ROLE."
          }
        }
      ]
    },
    {
      "name": "Negative / smoke",
      "item": [
        {
          "name": "Protected without token → 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Legacy static /pdfs → 404",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pdfs/"
          }
        },
        {
          "name": "Legacy static /uploads → 404",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/uploads/"
          }
        }
      ]
    }
  ]
}
