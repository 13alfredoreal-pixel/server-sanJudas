# Server
PORT=3000
URI_MONGODB=mongodb://127.0.0.1:27017/biblioteca-sjt

# JWT — secretos distintos (ej. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
TOKEN_KEY=change-me-access-secret
REFRESH_TOKEN_KEY=change-me-refresh-secret

# Admin seed (solo si no existe ningún ADMIN_ROLE)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sanjudas.edu.gt
ADMIN_NAME=Administrador
ADMIN_SURNAME=Principal
ADMIN_PASSWORD=change-me-strong-password

# Cloudinary (portadas / avatares — imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage (PDFs — bucket privado)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PDF_BUCKET=biblioteca-pdfs
