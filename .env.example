# Server
PORT=3000
URI_MONGODB=mongodb://127.0.0.1:27017/biblioteca-sjt

# JWT — usa secretos distintos (generar con crypto.randomBytes)
TOKEN_KEY=change-me-access-secret
REFRESH_TOKEN_KEY=change-me-refresh-secret

# Cloudinary (portadas / avatares — imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage (PDFs — bucket privado)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PDF_BUCKET=biblioteca-pdfs
